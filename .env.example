# Copy this file to .env and fill in your own values.
# These are browser-safe ("publishable") values. Server secrets go in Supabase, not here.

# Supabase: Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# Stripe pricing table (optional; only needed for the upgrade/pricing pages)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_key
VITE_STRIPE_PRICING_TABLE_ID=prctbl_your_table_id
